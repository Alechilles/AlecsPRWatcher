{
  "name": "codex-pr-review-watcher",
  "version": "0.1.0",
  "description": "Durable GitHub PR review watcher with MCP tools for Codex follow-up loops.",
  "type": "module",
  "bin": {
    "codex-pr-watcher": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "mcp": "tsx src/mcp.ts",
    "start": "node dist/src/server.js",
    "serve": "tsx src/server.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
